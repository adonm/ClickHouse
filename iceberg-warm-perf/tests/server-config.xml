<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
    <http_port>18124</http_port>
    <tcp_port>19001</tcp_port>
    <listen_host>127.0.0.1</listen_host>
    <path>tmp/clickhouse_test_server/</path>
    <tmp_path>tmp/clickhouse_test_server/tmp/</tmp_path>
    <user_files_path>@USER_FILES@</user_files_path>
    <mark_cache_size>536870912</mark_cache_size>
    <query_log>
        <database>system</database>
        <table>query_log</table>
    </query_log>
    <remote_servers>
        <parallel_replicas>
            <shard>
                <replica>
                    <host>localhost</host>
                    <port>19001</port>
                </replica>
            </shard>
        </parallel_replicas>
    </remote_servers>
    <profiles>
        <default>
            <allow_database_iceberg>1</allow_database_iceberg>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
    </users>
    <quotas>
        <default></default>
    </quotas>
</clickhouse>
