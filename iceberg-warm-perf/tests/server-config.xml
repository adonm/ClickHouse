<clickhouse>
    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
    <http_port>18124</http_port>
    <tcp_port>19001</tcp_port>
    <listen_host>127.0.0.1</listen_host>
    <path>${CLICKHOUSE_TEST_SERVER_DIR}/</path>
    <tmp_path>${CLICKHOUSE_TEST_SERVER_DIR}/tmp/</tmp_path>
    <user_files_path>${CLICKHOUSE_TEST_SERVER_DIR}/user_files/</user_files_path>
    <mark_cache_size>536870912</mark_cache_size>
    <query_log>
        <database>system</database>
        <table>query_log</table>
    </query_log>
    <profiles>
        <default>
            <allow_database_iceberg>1</allow_database_iceberg>
        </default>
    </profiles>
    <users>
        <default>
            <password></password>
            <networks>
                <ip>::/0</ip>
            </networks>
            <profile>default</profile>
            <quota>default</quota>
        </default>
    </users>
    <quotas>
        <default></default>
    </quotas>
</clickhouse>
